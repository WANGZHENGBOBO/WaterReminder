#define name 喝水BO～ 手表
#define color blue
#define glyph watch
#define version 26
#define from watch
#define mac false

#include 'actions/contacts'
#include 'actions/sharing'
#include 'actions/text'
#include 'actions/math'

#question recipient "收件人：填自己的 Apple ID 邮箱（仅 iMessage；先在 iPhone 关闭“以短信发送”）" ""

@amountInput = prompt("这次喝了多少 ml？", "Number", "197")
@amountText = getText(@amountInput)
const amountNumber = getNumbers(@amountText)
const roundedAmount = round(amountNumber)
@roundedText = getText(roundedAmount)
@amount = getNumbers(@roundedText)
if @amount < 1 || @amount > 2000 {
    alert("请输入 1～2000ml", "水量不正确")
    stop()
}
@payload = "drink:喝水BO～{@amount}"
const recipientText = text(recipient)
sendMessage(recipientText, @payload, false)
