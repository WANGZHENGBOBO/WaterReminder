#define name 喝水BO～
#define color blue
#define glyph waterDrop
#define version 26

#include 'actions/calendar'
#include 'actions/device'
#include 'actions/documents'
#include 'actions/math'
#include 'actions/network'
#include 'actions/text'
#include 'actions/web'

@today = formatDate(CurrentDate, "Custom", "yyyy-MM-dd")

@rawShortcutInput = ShortcutInput
@shortcutInputText = ""
if @rawShortcutInput {
    @shortcutInputText = getText(@rawShortcutInput)
}
@watchAmount = 0
@watchCommand = "phone"
if @shortcutInputText {
    @shortcutInputParts = splitText(@shortcutInputText, ":")
    @shortcutInputPartCount = count(@shortcutInputParts)
    if @shortcutInputPartCount == 2 {
        @shortcutKindField = getListItem(@shortcutInputParts, 1)
        @shortcutAmountField = getListItem(@shortcutInputParts, 2)
        @shortcutKindText = getText(@shortcutKindField)
        @shortcutAmountText = getText(@shortcutAmountField)
        @shortcutKind = trimWhitespace(@shortcutKindText)
        @shortcutCleanAmount = trimWhitespace(@shortcutAmountText)
        if @shortcutKind == "drink" {
            @watchAmount = getNumbers(@shortcutCleanAmount)
            @watchCommand = "drink"
        }
    }
}

@recordSyncFolder = getFile("/喝水BO～/Sync", nil, false)
if !@recordSyncFolder {
    alert("第一次使用时，iPhone 会询问是否允许快捷指令访问 iCloud 中的「快捷指令」文件夹。请点“始终允许”。它只用于读写喝水记录，授权后不会再反复询问。", "允许访问喝水记录")
    stop()
}

if @watchCommand == "drink" {
    @amountInput = @watchAmount
} else {
    @amountInput = prompt("这次喝了多少 ml？", "Number", "197")
}
@amountText = getText(@amountInput)
const amountNumber = getNumbers(@amountText)
const roundedAmount = round(amountNumber)
@roundedText = getText(roundedAmount)
@amount = getNumbers(@roundedText)
if @amount < 1 || @amount > 2000 {
    alert("请输入 1～2000ml", "水量不正确")
    stop()
}

@goal = 1800
@baseTotal = 0
@recordSummaryFile = getFile("/喝水BO～/Sync/today-summary.json", nil, false)
if @recordSummaryFile {
    @recordSummaryText = getText(@recordSummaryFile)
    @recordSummary = getDictionary(@recordSummaryText)
    @recordSummaryDay = "{@recordSummary['day']}"
    if @recordSummaryDay == @today {
        @recordGoalText = "{@recordSummary['goal']}"
        @recordTotalText = "{@recordSummary['total']}"
        @goal = getNumbers(@recordGoalText)
        @baseTotal = getNumbers(@recordTotalText)
        if !@goal { @goal = 1800 }
        if !@baseTotal { @baseTotal = 0 }
    }
}

@recordPhoneIPv4 = getLocalIP("IPv4")
@recordPhoneIPText = getText(@recordPhoneIPv4)
@recordPhoneParts = splitText(@recordPhoneIPText, ".")
@recordPhonePartCount = count(@recordPhoneParts)
@recordPhonePrefix = ""
if @recordPhonePartCount >= 3 {
    @recordPhonePart1 = getListItem(@recordPhoneParts, 1)
    @recordPhonePart2 = getListItem(@recordPhoneParts, 2)
    @recordPhonePart3 = getListItem(@recordPhoneParts, 3)
    @recordPhonePrefix = "{@recordPhonePart1}.{@recordPhonePart2}.{@recordPhonePart3}"
}

@recordBestFallbackURL = nothing()
@recordBestToken = nothing()
@recordBestShortName = nothing()
@recordBestRank = 0
@recordBestEpoch = 0
@recordDevicesFolder = getFile("/喝水BO～/Sync/Devices", nil, false)
if @recordDevicesFolder {
    @recordDeviceFiles = getFolderContents(@recordDevicesFolder)
    for recordDeviceFile in @recordDeviceFiles {
        @recordDeviceText = getText(@recordDeviceFile)
        @recordDevice = getDictionary(@recordDeviceText)
        if @recordDevice {
            @recordDeviceSubnet = "{@recordDevice['lanSubnet']}"
            @recordDeviceRole = "{@recordDevice['role']}"
            @recordDeviceEpochText = "{@recordDevice['lastSeenEpoch']}"
            @recordDeviceEpoch = getNumbers(@recordDeviceEpochText)
            @recordDeviceRank = 0
            if @recordDeviceRole == "primary" { @recordDeviceRank = 1 }
            if @recordDeviceSubnet == @recordPhonePrefix {
                if @recordDeviceRank > @recordBestRank {
                    @recordBestRank = @recordDeviceRank
                    @recordBestEpoch = @recordDeviceEpoch
                    @recordBestFallbackURL = "{@recordDevice['lanFallbackURL']}"
                    @recordBestToken = "{@recordDevice['lanToken']}"
                    @recordBestShortName = "{@recordDevice['shortName']}"
                } else {
                    if @recordDeviceRank == @recordBestRank && @recordDeviceEpoch > @recordBestEpoch {
                        @recordBestEpoch = @recordDeviceEpoch
                        @recordBestFallbackURL = "{@recordDevice['lanFallbackURL']}"
                        @recordBestToken = "{@recordDevice['lanToken']}"
                        @recordBestShortName = "{@recordDevice['shortName']}"
                    }
                }
            }
        }
    }
}

@displayTime = formatDate(CurrentDate, "Custom", "HH:mm")
@eventTime = formatDate(CurrentDate, "Custom", "yyyy-MM-dd'T'HH:mm:ssZZZZZ")
@eventStamp = formatDate(CurrentDate, "Custom", "yyyyMMddHHmmss")
@eventRandom = randomNumber(100000000, 999999999)
@eventID = "iphone-{@eventStamp}-{@eventRandom}"
@recordAmountText = getText(@amount)
@recordDisplayTimeText = getText(@displayTime)
@phoneDevice = getDeviceDetail('Device Name')
@phoneNameRaw = getText(@phoneDevice)
@phoneName = replaceText('"', "", @phoneNameRaw)
@eventParts = list(
    '{"schemaVersion":1,"id":"',
    @eventID,
    '","kind":"drink","recordID":"',
    @eventID,
    '","timestamp":"',
    @eventTime,
    '","milliliters":',
    @recordAmountText,
    ',"source":"iphone","deviceID":"iphone","deviceShortName":"iPH","deviceName":"',
    @phoneName,
    '"}'
)
@eventJSON = joinText(@eventParts, "")
@eventFile = saveFile("/喝水BO～/Sync/Events/{@eventID}.json", @eventJSON, true)
if !@eventFile {
    alert("这次记录没有保存成功，请重新运行快捷指令。", "没有保存")
    stop()
}

@total = @baseTotal + @amount
@recordHasSummaryToday = false
if @recordSummaryFile {
    if @recordSummaryDay == @today {
        @recordHasSummaryToday = true
    }
}
if !@recordHasSummaryToday {
    @recordCSVFile = getFile("/喝水BO～/Sync/喝水记录.csv", nil, false)
    @recordCSVText = ""
    if @recordCSVFile { @recordCSVText = getText(@recordCSVFile) }
    @recordCSVLines = splitText(@recordCSVText, "\n")
    @recordCSVTodayTotal = 0
    for recordCSVLine in @recordCSVLines {
        @recordCSVLineText = getText(@recordCSVLine)
        @recordFields = splitText(@recordCSVLineText, ",")
        @recordFieldCount = count(@recordFields)
        if @recordFieldCount == 6 {
            @recordKindField = getListItem(@recordFields, 2)
            @recordKindText = getText(@recordKindField)
            @recordKind = trimWhitespace(@recordKindText)
            if @recordKind == "drink" {
                @recordTimeField = getListItem(@recordFields, 4)
                @recordCSVAmountField = getListItem(@recordFields, 5)
                @recordTimeText = getText(@recordTimeField)
                @recordCSVAmountText = getText(@recordCSVAmountField)
                @recordCleanTime = trimWhitespace(@recordTimeText)
                @recordCleanAmount = trimWhitespace(@recordCSVAmountText)
                @recordLineAmount = getNumbers(@recordCleanAmount)
                @recordLineDates = getDates(@recordCleanTime)
                @recordLineTimestamp = getFirstItem(@recordLineDates)
                if @recordLineTimestamp {
                    if @recordLineTimestamp isToday {
                        if @recordLineAmount >= 1 && @recordLineAmount <= 2000 {
                            @recordCSVTodayTotal = @recordCSVTodayTotal + @recordLineAmount
                        }
                    }
                }
            }
        }
    }
    @total = @recordCSVTodayTotal + @amount
}
@percent = @total * 100
@percent = @percent / @goal
@remaining = @goal - @total
if @remaining < 0 { @remaining = 0 }

if @recordBestFallbackURL && @recordBestToken {
    rawAction("is.workflow.actions.downloadurl", {
        "WFURL": "{@recordBestFallbackURL}/v1/drink",
        "WFHTTPMethod": "POST",
        "WFHTTPBodyType": "File",
        "WFShowError": false,
        "WFRequestVariable": "${@eventFile}",
        "WFHTTPHeaders": {
            "Authorization": "Bearer {@recordBestToken}",
            "Content-Type": "application/json"
        }
    })
}

showNotification(
    "今日 {@total} / {@goal}ml，完成 {@percent}%，还差 {@remaining}ml",
    "已记录 {@amount}ml 💧",
    false
)
